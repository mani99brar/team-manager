{
  "version": "1.4.0",
  "feature": "Run each verification check once: shared candidate checks, policy 1.5.0 run-level checks and lane attribution of a run-level failure",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 600
    }
  ],
  "workers": [
    {
      "node_id": "engine",
      "role": "backend",
      "required_check_kinds": [
        "unit",
        "contract"
      ],
      "owned_paths": [
        "workflow",
        "contracts/workflow",
        "docs/handoff/run-checks-once.md"
      ],
      "checks": [
        {
          "id": "workflow-unit",
          "kind": "unit",
          "argv": [
            "/home/agentops/dev/md-manager/.venv/bin/python",
            "-m",
            "workflow.run_tests",
            "--jobs",
            "4"
          ],
          "timeout_seconds": 1800,
          "scenarios": []
        },
        {
          "id": "workflow-contract",
          "kind": "contract",
          "argv": [
            "npm",
            "run",
            "test:contracts"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        }
      ]
    }
  ]
}
