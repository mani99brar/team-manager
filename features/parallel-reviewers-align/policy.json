{
  "version": "1.2.0",
  "feature": "Parallel reviewers (slice B)",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 600
    }
  ],
  "workers": [
    {
      "node_id": "ui",
      "role": "frontend",
      "required_check_kinds": [
        "build",
        "browser"
      ],
      "owned_paths": [
        "src/projects",
        "tests/project-workflows"
      ],
      "checks": [
        {
          "id": "frontend-build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        },
        {
          "id": "frontend-unit-regression",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        },
        {
          "id": "project-workflows-browser",
          "kind": "browser",
          "argv": [
            "npx",
            "--no-install",
            "playwright",
            "test",
            "--config=tests/project-workflows/playwright.config.ts"
          ],
          "timeout_seconds": 300,
          "scenarios": [
            {
              "id": "viewer-two-reviewers",
              "description": "A seeded two-reviewer run shows both verdicts in the reviewer strip, a Reviewer column and filtering by reviewer; a legacy single-reviewer export shows one entry named review"
            }
          ]
        }
      ]
    },
    {
      "node_id": "adapter",
      "role": "backend",
      "required_check_kinds": [
        "unit"
      ],
      "owned_paths": [
        "workflow",
        "contracts",
        "server",
        "features/project-workflows"
      ],
      "checks": [
        {
          "id": "workflow-unit",
          "kind": "unit",
          "argv": [
            "/home/agentops/dev/md-manager/.venv/bin/python",
            "-m",
            "unittest",
            "discover",
            "-s",
            "workflow",
            "-t",
            "."
          ],
          "timeout_seconds": 1200,
          "scenarios": []
        },
        {
          "id": "shared-contract",
          "kind": "contract",
          "argv": [
            "npm",
            "run",
            "test:contracts"
          ],
          "timeout_seconds": 120,
          "scenarios": []
        },
        {
          "id": "backend-regression",
          "kind": "unit",
          "argv": [
            "npm",
            "run",
            "test:unit"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        },
        {
          "id": "backend-build",
          "kind": "build",
          "argv": [
            "npm",
            "run",
            "build"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        }
      ]
    }
  ]
}
