{
  "version": "1.2.0",
  "feature": "Lane reviewer: a lane may declare a reviewer that reviews its diff after verification and starts one fix round on a P0/P1",
  "independent_review": true,
  "integration_approval": true,
  "max_verification_attempts": 3,
  "setup": [
    {
      "argv": [
        "npm",
        "ci"
      ],
      "timeout_seconds": 600
    }
  ],
  "workers": [
    {
      "node_id": "engine",
      "role": "backend",
      "required_check_kinds": [
        "unit",
        "contract"
      ],
      "owned_paths": [
        "workflow",
        "contracts/workflow",
        "docs/handoff/lane-reviewer.md"
      ],
      "checks": [
        {
          "id": "workflow-unit",
          "kind": "unit",
          "argv": [
            "/home/agentops/dev/md-manager/.venv/bin/python",
            "-m",
            "workflow.run_tests"
          ],
          "timeout_seconds": 1500,
          "scenarios": []
        },
        {
          "id": "shared-contract",
          "kind": "contract",
          "argv": [
            "npm",
            "run",
            "test:contracts"
          ],
          "timeout_seconds": 180,
          "scenarios": []
        }
      ]
    }
  ]
}
