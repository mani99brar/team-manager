{
  "version": "2.10.0",
  "name": "Review panel registry (step 1 of the configurable review panel): a shared reviewer list pinned at prepare, a generic cli transport, and a judged run-review panel (feature.json 2.11.0) whose blind seats run beside the built-in reviewers and feed one Claude judge that rules on every finding, with the viewer for seats and rulings",
  "branch_prefix": "feature/review-panel-registry",
  "prd": "features/review-panel-registry/prd.md",
  "policy": "policy.json",
  "workers": [
    {
      "node_id": "seats",
      "task": "seats-task.md",
      "lane_review": {
        "reviewers": [
          {
            "transport": "pi",
            "model": "openai-codex/gpt-6.1-sol"
          }
        ],
        "rounds": 1,
        "timeout_minutes": 15
      },
      "model": "claude-opus-5-5",
      "effort": "medium"
    },
    {
      "node_id": "judge",
      "task": "judge-task.md",
      "lane_review": {
        "reviewers": [
          {
            "transport": "pi",
            "model": "openai-codex/gpt-6.1-sol"
          }
        ],
        "rounds": 1,
        "timeout_minutes": 15
      },
      "model": "claude-opus-5-5",
      "effort": "high"
    },
    {
      "node_id": "viewer",
      "task": "viewer-task.md",
      "skills": [
        "impeccable"
      ],
      "lane_review": {
        "reviewers": [
          {
            "transport": "pi",
            "model": "openai-codex/gpt-6.1-sol"
          }
        ],
        "rounds": 1,
        "timeout_minutes": 15
      },
      "model": "claude-opus-5-5",
      "effort": "medium"
    }
  ],
  "reviewers": [
    {
      "reviewer_id": "general",
      "prompt": "builtin:general"
    },
    {
      "reviewer_id": "coverage",
      "prompt": "builtin:coverage"
    }
  ],
  "panels": [
    {
      "id": "review",
      "stage": "review",
      "providers": [
        {
          "transport": "pi",
          "model": "openai-codex/gpt-6-astra"
        }
      ],
      "prompt": "builtin:review",
      "report_only": true,
      "budget_usd": 5,
      "timeout_minutes": 30
    }
  ],
  "critique": {
    "lanes": [
      "viewer"
    ],
    "skills": [
      "impeccable"
    ],
    "timeout_minutes": 45
  },
  "challenge": true,
  "critical": false,
  "tryout": false
}
