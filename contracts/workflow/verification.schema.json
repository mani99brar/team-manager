{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow verification policy v1 / v1.1 / v1.2",
  "description": "Policy 1.2.0 declares any number of worker lanes from configuration: lane ids follow a fixed pattern and avoid the reserved graph names, `role` is a free label and each lane lists the check kinds it must pass in `required_check_kinds`. Policies 1.0.0 and 1.1.0 stay accepted so pinned policies in old runs still validate; for them the controller derives the required kinds from the role (frontend: build and browser; backend: unit).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "feature",
    "workers",
    "independent_review",
    "integration_approval"
  ],
  "$defs": {
    "checkKind": {
      "enum": [
        "build",
        "typecheck",
        "unit",
        "integration",
        "contract",
        "browser"
      ]
    },
    "nodeId": {
      "description": "A worker lane id: lower-case, at most 32 characters, never a fixed graph node (review, candidate, handoff, approval, integrate), a finding attribution (multiple, none, both), a per-lane node prefix (launch_, verify_, candidate_, review-) or the design challenge's node and files (challenge, challenge-).",
      "type": "string",
      "pattern": "^(?!(?:review|candidate|handoff|approval|integrate|multiple|none|both|challenge)$)(?!(?:launch_|verify_|candidate_|review-|challenge-))[a-z][a-z0-9-]{0,31}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "max_verification_attempts"
              ]
            },
            {
              "required": [
                "failure_drill"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "enum": [
              "1.0.0",
              "1.1.0"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "workers": {
            "items": {
              "properties": {
                "role": {
                  "enum": [
                    "frontend",
                    "backend"
                  ]
                }
              },
              "not": {
                "required": [
                  "required_check_kinds"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "workers": {
            "items": {
              "required": [
                "required_check_kinds"
              ]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "feature": {
      "type": "string",
      "minLength": 1
    },
    "max_verification_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "failure_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "phase",
        "attempt"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/nodeId",
          "description": "Any declared lane; the controller checks it against `workers`. The drill applies only when that lane is selected for the run."
        },
        "phase": {
          "const": "worker"
        },
        "attempt": {
          "const": 1
        }
      }
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "timeout_seconds"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    "independent_review": {
      "const": true
    },
    "integration_approval": {
      "const": true
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "role",
          "owned_paths",
          "checks"
        ],
        "properties": {
          "node_id": {
            "$ref": "#/$defs/nodeId"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "description": "A free label used in prompts and the viewer (1.2.0). Before 1.2.0: frontend or backend, which also determined the required check kinds."
          },
          "required_check_kinds": {
            "description": "The check kinds this lane must pass; every listed kind must appear in the lane's `checks`. Required from 1.2.0.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/checkKind"
            }
          },
          "owned_paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "kind",
                "argv",
                "timeout_seconds",
                "scenarios"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "$ref": "#/$defs/checkKind"
                },
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "timeout_seconds": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3600
                },
                "scenarios": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "description"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
