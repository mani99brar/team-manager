{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow verification policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "feature", "workers", "independent_review", "integration_approval"],
  "properties": {
    "version": {"const": "1.0.0"},
    "feature": {"type": "string", "minLength": 1},
    "setup": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["argv", "timeout_seconds"],
        "properties": {
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    },
    "independent_review": {"const": true},
    "integration_approval": {"const": true},
    "workers": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "role", "owned_paths", "checks"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["frontend", "backend"]},
          "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "checks": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "kind", "argv", "timeout_seconds", "scenarios"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["build", "typecheck", "unit", "integration", "contract", "browser"]},
                "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
                "scenarios": {
                  "type": "array", "uniqueItems": true,
                  "items": {
                    "type": "object", "additionalProperties": false,
                    "required": ["id", "description"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "description": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
