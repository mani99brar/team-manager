{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "const": "review"
    },
    "launch_token": {
      "type": "string",
      "minLength": 1
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "accepted"
            ]
          },
          "worker": {
            "type": "string",
            "enum": [
              "ui",
              "adapter",
              "both",
              "none"
            ]
          },
          "requirement": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "severity",
          "message",
          "disposition",
          "worker",
          "requirement"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "node_id",
    "launch_token",
    "bundle_sha256",
    "candidate_commit",
    "verdict",
    "findings"
  ],
  "additionalProperties": false
}
