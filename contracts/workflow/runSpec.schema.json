{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "max_concurrent_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "workers": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "executor": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "type": "string",
            "minLength": 1
          },
          "worktree": {
            "type": "string",
            "minLength": 1
          },
          "observed_start_commit": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "owned_paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$"
            }
          },
          "acceptance_criteria": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "node_id",
          "executor",
          "task",
          "worktree",
          "observed_start_commit",
          "owned_paths",
          "acceptance_criteria"
        ],
        "additionalProperties": false
      }
    },
    "usage_exhaustion": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "pause_for_approval"
        },
        "alternative_plan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "alternative_plan"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "objective",
    "repository",
    "base_commit",
    "max_concurrent_workers",
    "workers",
    "usage_exhaustion"
  ],
  "additionalProperties": false
}
