{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "node_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "status_changed",
        "log",
        "artifact_published",
        "result_published",
        "approval_requested",
        "result_reused",
        "return_note"
      ]
    },
    "status": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "awaiting_approval",
            "paused",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "artifact": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "patch",
                "log",
                "screenshot",
                "test_report",
                "other",
                "file"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!\\/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "uri",
            "sha256"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "properties": {
                "kind": {
                  "const": "file"
                }
              },
              "required": [
                "path"
              ]
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "patch",
                    "log",
                    "screenshot",
                    "test_report",
                    "other"
                  ]
                },
                "path": {
                  "not": {}
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "result_uri": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "reused_from_attempt": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "event_id",
    "sequence",
    "occurred_at",
    "node_id",
    "attempt",
    "type",
    "status",
    "message",
    "artifact",
    "result_uri",
    "reused_from_attempt"
  ],
  "additionalProperties": false
}
