{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "repo": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "github",
            "not_github",
            "no_remote",
            "unavailable"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "owner_name": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}\\/[A-Za-z0-9_.-]{1,100}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "default_branch": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "owner_name",
        "url",
        "remote",
        "default_branch"
      ],
      "additionalProperties": false
    },
    "github": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "read",
            "pending",
            "off",
            "unavailable",
            "not_github"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "read_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewer_login": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "visibility": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "PUBLIC",
                "PRIVATE",
                "INTERNAL"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "viewer_permission": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ADMIN",
                "MAINTAIN",
                "WRITE",
                "TRIAGE",
                "READ"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "reason",
        "read_at",
        "viewer_login",
        "visibility",
        "viewer_permission"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "local_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tracking_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "github_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "push_state": {
          "type": "string",
          "enum": [
            "not_pushed",
            "up_to_date",
            "local_ahead",
            "remote_ahead",
            "diverged",
            "no_local_branch",
            "unknown"
          ]
        },
        "ahead_of_remote": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "behind_remote": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "ahead_of_default": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "behind_default": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "unpublished": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "subject": {
                "type": "string"
              },
              "author": {
                "type": "string"
              },
              "committed_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "sha",
              "subject",
              "author",
              "committed_at"
            ],
            "additionalProperties": false
          }
        },
        "unpublished_more": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "integrated_commit": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "contains_integrated": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "local_sha",
        "tracking_sha",
        "github_sha",
        "push_state",
        "ahead_of_remote",
        "behind_remote",
        "ahead_of_default",
        "behind_default",
        "unpublished",
        "unpublished_more",
        "integrated_commit",
        "contains_integrated"
      ],
      "additionalProperties": false
    },
    "pr": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "title": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "OPEN",
                "MERGED",
                "CLOSED"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "author": {
              "type": "string"
            },
            "head_ref": {
              "type": "string"
            },
            "base_ref": {
              "type": "string"
            },
            "head_sha": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,40}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "updated_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "merged_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "review_decision": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "APPROVED",
                    "CHANGES_REQUESTED",
                    "REVIEW_REQUIRED"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "mergeable": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "MERGEABLE",
                    "CONFLICTING",
                    "UNKNOWN"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "comments": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "review_threads": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unresolved_threads": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "requested_reviewers": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user",
                      "team",
                      "bot"
                    ]
                  },
                  "login": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "login"
                ],
                "additionalProperties": false
              }
            },
            "latest_reviews": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "author": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "APPROVED",
                      "CHANGES_REQUESTED",
                      "COMMENTED",
                      "DISMISSED",
                      "PENDING"
                    ]
                  },
                  "submitted_at": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "author",
                  "state",
                  "submitted_at"
                ],
                "additionalProperties": false
              }
            },
            "checks": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "SUCCESS",
                            "FAILURE",
                            "PENDING",
                            "ERROR",
                            "EXPECTED"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "passing": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "failing": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "pending": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "skipped": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "total": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "items": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "check_run",
                              "status"
                            ]
                          },
                          "status": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "conclusion": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "bucket": {
                            "type": "string",
                            "enum": [
                              "pass",
                              "fail",
                              "pending",
                              "skip",
                              "neutral"
                            ]
                          },
                          "url": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "name",
                          "kind",
                          "status",
                          "conclusion",
                          "bucket",
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "state",
                    "passing",
                    "failing",
                    "pending",
                    "skipped",
                    "total",
                    "items"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "number",
            "title",
            "url",
            "state",
            "draft",
            "author",
            "head_ref",
            "base_ref",
            "head_sha",
            "updated_at",
            "merged_at",
            "review_decision",
            "mergeable",
            "comments",
            "review_threads",
            "unresolved_threads",
            "requested_reviewers",
            "latest_reviews",
            "checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "earlier_prs": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "OPEN",
              "MERGED",
              "CLOSED"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "number",
          "title",
          "url",
          "state",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "project_id",
    "workflow_id",
    "run_id",
    "read_at",
    "repo",
    "github",
    "branch",
    "pr",
    "earlier_prs"
  ],
  "additionalProperties": false
}
