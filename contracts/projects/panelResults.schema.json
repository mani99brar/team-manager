{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "enum": [
              "challenge",
              "review"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "timed_out"
            ]
          },
          "overlap_threshold": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "const": "all"
              }
            ]
          },
          "context_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "transport": {
                  "type": "string",
                  "enum": [
                    "claude",
                    "pi"
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "effort": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "pending",
                    "running",
                    "ok",
                    "timed_out",
                    "error",
                    "parse_failed"
                  ]
                },
                "cost_usd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "context_bytes": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "finding_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "transport",
                "model",
                "effort",
                "status",
                "cost_usd",
                "context_bytes",
                "finding_ids",
                "error"
              ],
              "additionalProperties": false
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "P0",
                    "P1",
                    "P2"
                  ]
                },
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "providers_raised": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "accepted": {
                  "type": "boolean"
                },
                "unanchored": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "severity",
                "file",
                "line",
                "title",
                "detail",
                "providers_raised",
                "accepted",
                "unanchored"
              ],
              "additionalProperties": false
            }
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "budget_usd": {
            "type": "number",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "stage",
          "status",
          "overlap_threshold",
          "context_bytes",
          "providers",
          "findings",
          "started_at",
          "ended_at",
          "budget_usd",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "contract_version": {
      "type": "string",
      "const": "1.9.0"
    },
    "source": {
      "type": "string",
      "enum": [
        "live",
        "export"
      ]
    }
  },
  "required": [
    "version",
    "panels",
    "contract_version",
    "source"
  ],
  "additionalProperties": false
}
