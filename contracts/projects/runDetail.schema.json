{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "definition_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "awaiting_approval",
            "paused",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "workflow_id",
        "definition_revision",
        "run_id",
        "status",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "workflow_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nodes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "prepare",
                  "worker",
                  "verification",
                  "review",
                  "integration"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                }
              }
            },
            "required": [
              "node_id",
              "label",
              "kind",
              "depends_on"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_version",
        "project_id",
        "workflow_id",
        "name",
        "definition_revision",
        "nodes"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "contract_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "running",
            "awaiting_approval",
            "paused",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "prepare",
                  "worker",
                  "verification",
                  "review",
                  "integration"
                ]
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "running",
                  "awaiting_approval",
                  "paused",
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              },
              "attempt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "session_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "result_uri": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lane_results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "worker": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attempt": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "result_uri": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "worker",
                    "attempt",
                    "result_uri"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "node_id",
              "kind",
              "depends_on",
              "status",
              "attempt",
              "session_id",
              "result_uri",
              "lane_results"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contract_version",
        "run_id",
        "status",
        "last_sequence",
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "summary",
    "definition",
    "snapshot"
  ],
  "additionalProperties": false
}
