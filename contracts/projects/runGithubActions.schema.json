{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0"
    },
    "enabled": {
      "type": "boolean"
    },
    "state_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repo": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}\\/[A-Za-z0-9_.-]{1,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "visibility": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "PUBLIC",
            "PRIVATE",
            "INTERNAL"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "minItems": 4,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "push_branch",
              "open_pr",
              "mark_ready",
              "request_reviewers"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "available": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "confirm": {
            "type": "string",
            "enum": [
              "plain",
              "typed_repo"
            ]
          },
          "params": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "title"
                    },
                    "kind": {
                      "type": "string",
                      "const": "text"
                    },
                    "min_length": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "max_length": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "required": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "name",
                    "kind",
                    "min_length",
                    "max_length",
                    "required"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "body"
                    },
                    "kind": {
                      "type": "string",
                      "const": "multiline"
                    },
                    "min_length": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "max_length": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "required": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "name",
                    "kind",
                    "min_length",
                    "max_length",
                    "required"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "reviewers"
                    },
                    "kind": {
                      "type": "string",
                      "const": "list"
                    },
                    "max_items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "suggestions": {
                      "maxItems": 30,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "name",
                    "kind",
                    "max_items",
                    "suggestions",
                    "required"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "const": "confirm_repo"
                    },
                    "kind": {
                      "type": "string",
                      "const": "typed"
                    },
                    "required": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "name",
                    "kind",
                    "required"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "defaults": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "reviewers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "effect": {
            "type": "string",
            "minLength": 1
          },
          "not_effect": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "publishes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label",
          "available",
          "reason",
          "command",
          "confirm",
          "params",
          "defaults",
          "effect",
          "not_effect",
          "publishes"
        ],
        "additionalProperties": false
      }
    },
    "records": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^g-[0-9a-f]{12}$"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "action": {
            "type": "string",
            "enum": [
              "push_branch",
              "open_pr",
              "mark_ready",
              "request_reviewers"
            ]
          },
          "params": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "body_chars": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "reviewers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed",
              "refused",
              "lost"
            ]
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "ended_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "output_tail": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "record_id",
          "request_id",
          "action",
          "params",
          "command",
          "status",
          "exit_code",
          "started_at",
          "ended_at",
          "output_tail",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "enabled",
    "state_token",
    "repo",
    "visibility",
    "actions",
    "records"
  ],
  "additionalProperties": false
}
