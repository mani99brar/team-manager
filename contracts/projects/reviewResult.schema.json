{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "node_id": {
      "type": "string",
      "const": "review"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "type": "string",
          "enum": [
            "native",
            "print",
            "manual"
          ]
        },
        "independent": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "session_id",
        "transport",
        "independent"
      ],
      "additionalProperties": false
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "accepted"
            ]
          },
          "worker": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ui",
                  "adapter",
                  "both",
                  "none"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "requirement": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "requirement_found_in": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ui",
                "adapter"
              ]
            }
          }
        },
        "required": [
          "severity",
          "message",
          "disposition",
          "worker",
          "requirement",
          "requirement_found_in"
        ],
        "additionalProperties": false
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "diff": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "artifact_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "enum": [
                "patch",
                "log",
                "screenshot",
                "test_report",
                "other"
              ]
            },
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "artifact_id",
            "kind",
            "uri",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "run_id",
    "node_id",
    "attempt",
    "reviewer",
    "bundle_sha256",
    "candidate_commit",
    "verdict",
    "findings",
    "reviewed_at",
    "diff"
  ],
  "additionalProperties": false
}
