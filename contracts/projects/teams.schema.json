    "totals": {
      "type": "object",
      "properties": {
        "sessions_with_teams": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workflows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workflows_running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "agents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "interrupted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sessions_with_teams",
        "workflows",
        "workflows_running",
        "agents",
        "queued",
        "running",
        "done",
        "failed",
        "interrupted",
        "tool_calls"
      ],
      "additionalProperties": false
